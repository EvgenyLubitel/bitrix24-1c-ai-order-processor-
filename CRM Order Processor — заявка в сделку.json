      "id": "a939ab52-a2d6-49bd-97ae-1b6232187c2e",
      "name": "Ответ клиенту"
    },
    {
      "parameters": {
        "jsCode": "// Получаем данные из body запроса\nconst body = $input.first().json.body || $input.first().json;\n\n// Извлекаем поля (даже если они повреждены, пробуем восстановить)\nconst client = body.client || body.client_utf8 || \"Не указан\";\nconst contact = body.contact || \"Не указан\";\nconst message = body.message || body.message_text || \"Нет сообщения\";\n\n// Логируем для отладки\nconsole.log(\"=== ВОССТАНОВЛЕННЫЕ ДАННЫЕ ===\");\nconsole.log(\"client:\", client);\nconsole.log(\"contact:\", contact);\nconsole.log(\"message:\", message);\n\n// Возвращаем чистые данные\nreturn {\n  client: client,\n  contact: contact,\n  message: message,\n  timestamp: new Date().toISOString()\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1168,
        1296
      ],
      "id": "beb0c56d-daa0-4371-b565-d528fd9a003e",
      "name": "приём заявки",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const client = $json.client || 'Не указан';\nconst offer = $json.offer || 'Нет предложения';\n\nreturn {\n  success: true,\n  message: 'Заявка обработана',\n  client: client,\n  offer: offer\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -128,
        -128
      ],
      "id": "1fc01733-eef6-41b9-bc1c-9a5b049a9e48",
      "name": "Подготовка финального ответа"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nreturn {\n  client: body.client,\n  contact: body.contact,\n  message: body.message\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1152,
        0
      ],
      "id": "25df3c4b-f8d0-44e7-937f-046edbab3e54",
      "name": "Передача client"
    },
    {
      "parameters": {
        "jsCode": "const client = $json.client;\nconst message = $json.message;\n\nconst offer = `КОММЕРЧЕСКОЕ ПРЕДЛОЖЕНИЕ\n\nКлиент: ${client}\nЗапрос: ${message}\n\nБлагодарим за обращение! Менеджер свяжется с вами.\n\nИтого: по запросу`;\n\nreturn {\n  client: client,\n  offer: offer,\n  message: message\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        -128
      ],
      "id": "74ae2f42-629f-4c6e-99bb-71acfcd575c9",
      "name": "Генерация КП"
    },
    {
      "parameters": {
        "jsCode": "// Извлекаем данные из поля text (это строка JSON)\nconst textData = $json.text;\n\nlet client = '';\nlet contact = '';\nlet message = '';\nlet intent = '';\nlet confidence = 0;\n\ntry {\n  const parsed = JSON.parse(textData);\n  client = parsed.client;\n  contact = parsed.contact;\n  message = parsed.message;\n  intent = parsed.intent;\n  confidence = parsed.confidence;\n} catch(e) {\n  console.log('Ошибка парсинга:', e);\n}\n\n// Возвращаем плоскую структуру\nreturn {\n  client: client,\n  contact: contact,\n  message: message,\n  intent: intent,\n  confidence: confidence\n};"
      },
